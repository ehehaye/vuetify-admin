{
  "name": "vuetify-admin",
  "version": "0.0.2",
  "private": true,
  "author": "hongxin.tang@hotmail.com",
  "license": "MIT",
  "description": "基于 vuetify4 的自带诸多后台管理系统模板，内置动态路由、权限验证等功能",
  "keywords": [
    "vuetify",
    "material-design",
    "MD",
    "vue"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src types",
    "lint:fix": "pnpm lint --fix",
    "test": "echo 'Tests are not prepared.'",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@rthx/utils": "~0.2.4",
    "@rthx/vue3-amap": "~0.1.16",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "material-design-icons-iconfont": "^6.7.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "qs": "^6.16.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "axios-mock-adapter": "^2.1.0",
    "code-inspector-plugin": "^2.0.9",
    "eslint": "9.39.5",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass-embedded": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.5",
    "vite-plugin-compression": "^0.5.1",
