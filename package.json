{
  "name": "vuetify-admin",
  "version": "0.0.2",
  "private": true,
  "author": "hongxin.tang@hotmail.com",
  "license": "MIT",
  "description": "基于 vuetify4 的自带诸多后台管理系统模板，内置动态路由、权限验证等功能",
  "keywords": [
    "vuetify",
    "material-design",
    "MD",
    "vue"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src types",
    "lint:fix": "pnpm lint --fix",
    "test": "echo 'Tests are not prepared.'",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@rthx/utils": "~0.2.4",
    "@rthx/vue3-amap": "~0.1.16",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "material-design-icons-iconfont": "^6.7.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "qs": "^6.15.2",
    "vue": "^3.5.13",
    "vue-router": "^5.0.2",
    "vuetify": "^4.2.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.12.7",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "axios-mock-adapter": "^2.1.0",
    "code-inspector-plugin": "^1.5.1",
    "eslint": "9.32.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass-embedded": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^7.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.13"
